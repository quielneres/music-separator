# Configurações do Servidor
PORT=5050
NODE_ENV=development

# Banco de Dados MongoDB
MONGO_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/e2nstudio?retryWrites=true&w=majority

# Chave Secreta JWT (Gere uma chave segura e aleatória para produção)
JWT_SECRET=substitua_por_uma_chave_secreta_longa_e_aleatoria_em_producao

# URL do Serviço de Processamento de Áudio (FastAPI ou Worker)
FASTAPI_ENGINE_URL=http://127.0.0.1:8000
MAX_FILE_SIZE_MB=250

# Fila Redis (opcional para filas locais/Upstash)
REDIS_URL=redis://127.0.0.1:6379

# Google Cloud Storage (Opcional se utilizar GCS para produção)
# GCS_BUCKET_NAME=moises-clone-stems
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/credentials.json
